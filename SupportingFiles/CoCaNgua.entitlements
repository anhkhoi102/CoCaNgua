<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements của Cờ Cá Ngựa.
  App Sandbox bật; network.client cần cho Game Center.
  com.apple.developer.game-center CHƯA được khai báo: đó là entitlement bị hạn chế, chỉ dùng được khi
  ký bằng provisioning profile của tài khoản Apple Developer (xem Docs/ARCHITECTURE.md, mục Game Center).
  Sẽ được thêm ở Phase 4.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
